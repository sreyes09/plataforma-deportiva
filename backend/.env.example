# Puerto interno del backend dentro de Docker.
PUERTO=5000

# Conexion principal a MongoDB Atlas.
MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/vyrox

# Llave del JWT.
JWT_SECRETO=reemplazar-por-una-clave-larga-y-segura

# Configuracion SMTP para correos 2FA y restablecimiento.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vyrox.co@gmail.com
SMTP_PASS=app_password_aqui
SMTP_SECURE=true
SMTP_FROM=Vyrox <vyrox.co@gmail.com>

# Permite fallback local si en algun momento lo ocupan fuera de produccion.
SMTP_PERMITIR_RESPALDO_LOCAL=false
